{
  "name": "raganor-opc",
  "version": "0.1.0",
  "description": "Raganor OPC - Multi-Agent One-Person Company Framework",
  "type": "module",
  "bin": {
    "brief": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "brief:morning": "tsx src/cli/index.ts morning",
    "brief:evening": "tsx src/cli/index.ts evening"
  },
  "keywords": [
